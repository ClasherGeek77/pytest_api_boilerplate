# settings for run_test.sh, the tests read them through lib/constants.py
BASE_URL=http://localhost:40000
API_TIMEOUT=10       # seconds per request
RESET_SERVICES=0     # 1 = wipe the services before the first and after the last test, needs ApiClient.reset_all filled in
# REQRESIN_CLONE_DIR=../reqresin_clone   # only used when BASE_URL answers nothing, then the tests start the clone themselves and stop it again after the run
